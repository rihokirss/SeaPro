[Unit]
Description=SeaPro history maintenance and backup
After=postgresql.service

[Service]
Type=oneshot
User=seapro
WorkingDirectory=/opt/seapro
ExecStart=/usr/bin/node --env-file=.env node_modules/tsx/dist/cli.mjs server/src/db/cli.ts maintain
ExecStart=/usr/bin/node --env-file=.env scripts/database-backup.mjs
TimeoutStartSec=2h
UMask=0077
Nice=10
