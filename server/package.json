{
  "name": "@seapro/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@seapro/shared": "*",
    "d3-contour": "^4.0.2",
    "fastify": "^5.11.0",
    "geotiff": "^3.0.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
