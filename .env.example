# SeaPro konfiguratsioon
# Kopeeri see fail .env-iks ja täida väärtused:  cp .env.example .env
# .env on .gitignore'is ja ei tohi kunagi repos olla.

# --- Server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- Identifitseerimine ---
# Läheb kõigi väljaminevate päringute User-Agenti.
# MET Norway ToS NÕUAB tuvastatavat kontakti, muidu 403.
CONTACT_EMAIL=sinu@email.ee
APP_VERSION=0.1.0

# --- API võtmed ---
# Ainus päris võti kogu projektis. Valikuline.
# Ilma selleta töötab AIS edasi Fintraffic Digitraffici kaudu (võtmeta),
# aga Liivi laht ja Väinameri jäävad katmata.
# Hankimine: https://aisstream.io -> logi sisse GitHubiga -> API Keys -> Create
# Vt docs/api-keys.md
AISSTREAM_KEY=

# --- Vahemälu TTL-id (sekundites) ---
CACHE_TTL_OPENMETEO=900
CACHE_TTL_METNO=1200
CACHE_TTL_METOC=240
CACHE_TTL_LAINEPOISS=300
CACHE_TTL_ILMATEENISTUS=300
CACHE_TTL_WINDFINDER=1800
CACHE_TTL_AIS=30

# --- Taustatööd ---
# Kas server tõmbab jaamaandmeid taustal (soovitatav: 1).
BACKGROUND_POLL=1

# --- Piirkond ---
# Vaikimisi kaardivaade ja AIS-tellimuse bbox: Läänemeri / Eesti
DEFAULT_LAT=59.0
DEFAULT_LON=23.5
DEFAULT_ZOOM=7
AIS_BBOX=57.0,20.0,60.5,29.0
