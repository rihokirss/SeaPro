# SeaPro konfiguratsioon / SeaPro configuration
# Kopeeri see fail .env-iks ja täida väärtused:  cp .env.example .env
# Copy this file to .env and fill in the values:  cp .env.example .env
# .env on .gitignore'is ja ei tohi kunagi repos olla.
# .env is listed in .gitignore and must never be committed to the repository.

# --- Server / Server ---
PORT=8080
HOST=0.0.0.0
# NODE_ENV-i siia EI panda — selle määrab skript:
# Do NOT set NODE_ENV here — it is set by the script:
#   npm run dev  -> development (pino-pretty logi, tsx watch)
#   npm run dev  -> development (pino-pretty logging, tsx watch)
#   npm start    -> production
# Shellis seatud muutuja võidab --env-file väärtuse, seega siinne rida oleks surnud.
# A shell variable overrides the --env-file value, so a line here would have no effect.
LOG_LEVEL=info

# --- Identifitseerimine / Identification ---
# Läheb kõigi väljaminevate päringute User-Agenti.
# Added to the User-Agent of every outgoing request.
# MET Norway ToS NÕUAB tuvastatavat kontakti, muidu 403.
# MET Norway's ToS REQUIRES identifiable contact information, otherwise it returns 403.
CONTACT_EMAIL=sinu@email.ee
APP_VERSION=0.1.0

# --- API võtmed / API keys ---
# Valikuline. Võtme lisamisel kasutatakse automaatselt Open-Meteo tasulisi
# customer-endpointe ja tasuta paketi tunni-/päevapiirajat ei rakendata.
# Optional. When a key is provided, the paid Open-Meteo customer endpoints are
# used automatically and the free-tier hourly/daily limiter is disabled.
# Hankimine / Get a key: https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=
# Standard = 1000000, Professional = 5000000
OPEN_METEO_MONTHLY_LIMIT=1000000

# Valikuline AISStreami võti.
# Ilma selleta töötab AIS edasi Fintraffic Digitraffici kaudu (võtmeta),
# aga Liivi laht ja Väinameri jäävad katmata.
# Optional AISStream key.
# Without it, AIS continues through Fintraffic Digitraffic (no key required),
# but the Gulf of Riga and Väinameri are not covered.
# Hankimine / Get a key: https://aisstream.io -> logi sisse GitHubiga / sign in with GitHub
#   -> API Keys -> Create
# Vt / See docs/api-keys.md
AISSTREAM_KEY=

# --- Vahemälu TTL-id (sekundites) / Cache TTLs (seconds) ---
# Tund = Open-Meteo mudelijooksude oma tempo (MET Nordic 1 h, ICON-EU 3 h,
# GFS 6 h). Lühem TTL ei anna värskemat prognoosi, kulutab ainult
# päringueelarvet — ja see on punktipõhise arvestuse tõttu kitsas.
# One hour matches the Open-Meteo model update cadence (MET Nordic 1 h,
# ICON-EU 3 h, GFS 6 h). A shorter TTL does not provide a fresher forecast;
# it only consumes the limited point-based request budget.
CACHE_TTL_OPENMETEO=3600
CACHE_TTL_METNO=1200
CACHE_TTL_METOC=240
CACHE_TTL_LAINEPOISS=300
CACHE_TTL_ILMATEENISTUS=300
CACHE_TTL_WINDFINDER=1800
CACHE_TTL_AIS=30
# Staatiliste routingupaanide jaoks; PM2 2 GiB protsessipiiriga ohutu varu.
# Safe allowance for static routing tiles with the PM2 2 GiB process limit.
CACHE_MAX_MEMORY_MB=192
# Tihedad OSM-i ja Väylävirasto paanid võivad ületada vana 2 MiB piiri.
# Dense OSM and Väylävirasto tiles may exceed the old 2 MiB limit.
CACHE_MAX_PERSISTED_ENTRY_MB=8

# --- Taustatööd / Background jobs ---
# Kas server tõmbab jaama- ning AIS-andmeid taustal (soovitatav: 1).
# Whether the server fetches station and AIS data in the background (recommended: 1).
BACKGROUND_POLL=1
# Staatiliste routingupaanide lai eellaadimine. Avalikus näites vaikimisi väljas.
# Wide preloading of static routing tiles. Disabled by default in the public example.
ROUTING_PREWARM=0

# --- Piirkond / Region ---
# Vaikimisi kaardivaade ja AIS-tellimuse bbox: Läänemeri / Eesti
# Default map view and AIS subscription bbox: Baltic Sea / Estonia
DEFAULT_LAT=59.0
DEFAULT_LON=23.5
DEFAULT_ZOOM=7
AIS_BBOX=53.0,9.0,66.0,31.5
# Ilmaandmete avalike API-de eraldi kulupiirid [lõuna,lääs,põhi,ida].
# Separate cost limits for public weather APIs [south,west,north,east].
WEATHER_GRID_BBOX=53.0,12.0,66.7,31.5
WEATHER_POINT_BBOX=53.0,12.0,66.7,31.5

# Automaatmarsruudi serveripoolne katvus ja ressursipiirid.
# Server-side autorouting coverage and resource limits.
ROUTING_BBOX=57.45,18.75,66.2,28.45
# Ettevalmistatava navigatsioonigraafi ala ja fail. Graaf koostatakse käsuga
# `npm run data:routing-graph`; runtime loeb ainult seda valmis faili.
# Area and file for the prepared navigation graph. Build it with
# `npm run data:routing-graph`; runtime reads only this prepared file.
ROUTING_GRAPH_BBOX=57.45,18.75,62,29
ROUTING_GRAPH_FILE=data/routing-graph-v2.json
ROUTING_MAX_DISTANCE_NM=500
# Kogu snapshot'i, klassifitseerimise, lihtsustamise ja otsingu ajapiir.
# Overall timeout for snapshot loading, classification, simplification, and search.
ROUTING_PLAN_TIMEOUT_MS=90000
# Hoiab välisallikad ning CPU kontrolli all.
# Keeps external data sources and CPU usage under control.
ROUTING_MAX_CONCURRENT_PLANS=2
ROUTING_SEARCH_TIMEOUT_MS=45000
ROUTING_SEARCH_MAX_NODES=1000000
# Logib iga marsruudiplaani faasiajad (benchmark/profiilimine).
# Logs phase timings for every route plan (benchmarking/profiling).
ROUTING_TIMINGS_LOG=0
